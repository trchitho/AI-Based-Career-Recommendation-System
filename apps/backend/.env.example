# Postgres Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/career_ai

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
FRONTEND_OAUTH_REDIRECT=https://yourdomain.com/oauth/callback
ALLOWED_ORIGINS=https://yourdomain.com

# Neo4j Graph Database
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password

# AI models (đường dẫn tới package ai-core)
AI_MODELS_DIR=packages/ai-core/models

# SMTP for verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
FRONTEND_VERIFY_URL=https://yourdomain.com/verify?token={token}
EMAIL_DELIVERABILITY_REQUIRED=false
EMAIL_SMTP_PROBE_PORT=25
EMAIL_SMTP_PROBE_TIMEOUT=5

# O*NET API (Get from https://services.onetcenter.org/reference/)
ONET_V2_API_KEY=your_onet_api_key_here
ONET_V2_BASE_URL=https://api-v2.onetcenter.org
ONET_V2_TIMEOUT=30

# ZaloPay Payment Gateway (Production - Replace with your keys)
ZALOPAY_APP_ID=your_zalopay_app_id
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_ENDPOINT=https://openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://yourdomain.com/api/payment/callback
ZALOPAY_REDIRECT_URL=https://yourdomain.com/payment/return

# Google Gemini API - 4 separate streams for better quota management
# Chatbot API Key (Get from Google AI Studio)
GEMINI_CHATBOT_API_KEY=your_gemini_chatbot_api_key_here
GEMINI_CHATBOT_MODEL=gemini-flash-latest

# Assessment/Story Generator API Key (need different key for quota)
GEMINI_ASSESSMENT_API_KEY=your_gemini_assessment_api_key_here
GEMINI_ASSESSMENT_MODEL=gemini-flash-latest

# CV Analysis API Key (need different key for quota)
GEMINI_CV_API_KEY=your_gemini_cv_api_key_here
GEMINI_CV_MODEL=gemini-flash-latest

# Interview API Key (for AI Mock Interview feature)
GEMINI_INTERVIEW_API_KEY=your_gemini_interview_api_key_here
GEMINI_INTERVIEW_MODEL=models/gemma-3-12b-it
GEMINI_MODEL=models/gemma-3-12b-it
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# Global Gemini Settings
GEMINI_MAX_TOKENS=-1
GEMINI_TEMPERATURE=0.7
USE_AI_MATCHING=true
GEMINI_ENABLED=true
# Quota management - Optimized for speed
GEMINI_RETRY_DELAY=5
GEMINI_MAX_RETRIES=1
AI_FAST_FAIL=true

# Legacy support (fallback to chatbot key)
GEMINI_API_KEY=your_gemini_fallback_api_key_here

# Fallback Models Configuration
GEMINI_ENABLE_FALLBACK=true
# Backup API Keys (when primary keys exceed quota)
GEMINI_CHATBOT_BACKUP_KEY=your_gemini_backup_key_here
GEMINI_ASSESSMENT_BACKUP_KEY=your_gemini_backup_key_here
GEMINI_CV_BACKUP_KEY=your_gemini_backup_key_here
GEMINI_INTERVIEW_BACKUP_KEY=your_gemini_backup_key_here

# Cloudflare R2 Storage (for CV uploads)
CF_R2_ACCOUNT_ID=your_cloudflare_account_id
CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CF_R2_BUCKET_NAME=your_bucket_name
CF_R2_PUBLIC_URL=https://your-bucket-url.r2.dev

